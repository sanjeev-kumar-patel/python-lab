    "Q51 SQL Joins": {
        "prefix": "q51-sql-joins",
        "body": [
            "import sqlite3",
            "",
            "with sqlite3.connect(\":memory:\") as conn:",
            "    conn.executescript(\"\"\"",
            "    CREATE TABLE Students(id INTEGER, name TEXT, dept_id INTEGER);",
            "    CREATE TABLE Departments(dept_id INTEGER, department TEXT);",
            "    INSERT INTO Students VALUES (1,'Sanjeev',101),(2,'Mohan',102),(3,'Rohan',103),(4,'Ram',104);",
            "    INSERT INTO Departments VALUES (101,'CSE'),(102,'ECE'),(105,'Mechanical');",
            "    \"\"\")",
            "    queries = {",
            "        \"INNER JOIN\": \"SELECT s.id,s.name,d.department FROM Students s INNER JOIN Departments d ON s.dept_id=d.dept_id\",",
            "        \"LEFT JOIN\": \"SELECT s.id,s.name,d.department FROM Students s LEFT JOIN Departments d ON s.dept_id=d.dept_id\",",
            "        \"RIGHT JOIN (portable)\": \"SELECT s.id,s.name,d.department FROM Departments d LEFT JOIN Students s ON s.dept_id=d.dept_id\",",
            "        \"FULL OUTER JOIN (portable)\": \"SELECT s.id,s.name,d.department FROM Students s LEFT JOIN Departments d ON s.dept_id=d.dept_id UNION SELECT s.id,s.name,d.department FROM Departments d LEFT JOIN Students s ON s.dept_id=d.dept_id\"",
            "    }",
            "    for title, query in queries.items():",
            "        print(\"\\n\" + title)",
            "        print(conn.execute(query).fetchall())"
        ],
        "description": "Demonstrate INNER, LEFT, RIGHT-equivalent, and FULL OUTER joins in SQLite."
    },
